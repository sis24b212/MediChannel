# Public URL of the Spring Boot API (e.g., http://localhost:8080 or https://medichannel-api.onrender.com)
NEXT_PUBLIC_API_URL=http://localhost:8080

# WebSocket URL (ws://localhost:8080/ws-native locally, wss://medichannel-api.onrender.com/ws-native in production)
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws-native

# Server-side API URL used by Next.js Route Handlers (can match NEXT_PUBLIC_API_URL)
API_BASE_URL=http://localhost:8080
