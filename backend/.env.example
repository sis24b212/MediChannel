# Server Port
PORT=8080

# PostgreSQL Database (Neon or Local)
DB_URL=jdbc:postgresql://localhost:5432/medichannel?sslmode=disable
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password

# Frontend URL for CORS (e.g., http://localhost:3000 or https://your-app.vercel.app)
FRONTEND_URL=http://localhost:3000

# Security Secrets (Generate strong random values; NEVER commit real keys!)
# JWT_SECRET must be at least 32 characters long
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRATION_MS=86400000

# Base64-encoded 32-byte (256-bit) AES key. Generate with: openssl rand -base64 32
ENCRYPTION_KEY_BASE64=replace_with_base64_32_byte_aes_key

# HMAC-SHA256 secret for searchable blind indexes (email & NIC)
HMAC_SECRET=replace_with_random_hmac_secret_string

# Initial Admin Account (Created automatically on startup)
INITIAL_ADMIN_EMAIL=admin@lankacare.lk
INITIAL_ADMIN_PASSWORD=Admin@12345
INITIAL_ADMIN_NAME=System Administrator

# Seed realistic fictional demo data on empty database (true / false)
SEED_DEMO_DATA=true
